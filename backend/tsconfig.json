{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "typeRoots": ["./src/types"],
    "paths": {
      "@ink-spirit/shared": ["../shared/index.ts"]
    }
  },
  "include": ["src/**/*", "prisma/seed.ts", "../shared/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
