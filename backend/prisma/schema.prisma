generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 文章访问级别
enum AccessLevel {
  PUBLIC    // 公开，所有人可见
  PRIVATE   // 私密，仅管理员可见
  PASSWORD  // 密码保护，输入密码后可见
}

// 文章
model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  date        DateTime @default(now())
  category    String
  tags        String[]
  readingTime String?

  viewCount   Int      @default(0)
  likeCount   Int      @default(0)

  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  // 访问控制
  accessLevel AccessLevel @default(PUBLIC)
  password    String?       // 密码保护时使用

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments    Comment[]
  authorId    String?
  author      User?    @relation("PostAuthor", fields: [authorId], references: [id])

  @@index([category])
  @@index([date])
  @@index([isPublished])
  @@index([authorId])
  @@index([accessLevel])
  @@index([isPublished, date])
  @@index([isPublished, accessLevel])
  @@index([isPublished, category])
  @@map("posts")
}

// 公告
model Announcement {
  id       String   @id @default(cuid())
  title    String
  content  String
  date     DateTime @default(now())
  type     AnnouncementType @default(INFO)

  attachments Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@map("announcements")
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  IMPORTANT
}

// 项目
model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  type        String
  tech        String[]
  status      ProjectStatus @default(ACTIVE)

  link        String?
  imageUrl    String?
  githubUrl   String?
  demoUrl     String?

  startDate   DateTime?
  endDate     DateTime?

  readme      String?

  featured    Boolean       @default(false)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([featured])
  @@index([featured, status])
  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DEPLOYED
}

// 技能
model Skill {
  id            String     @id @default(cuid())
  name          String     @unique
  category      String
  level         Int        @default(0)
  rank          String
  projectCount  Int        @default(0)

  nodeX         Float?
  nodeY         Float?
  nodeType      NodeType?
  connections   String[]

  // 图片
  image         String?

  // 按钮配置
  buttonEnabled Boolean   @default(false)
  buttonLabel   String?
  buttonLink    String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([category])
  @@index([level])
  @@map("skills")
}

enum NodeType {
  core
  major
  minor
}

// 时间线事件
model TimelineEvent {
  id          String    @id @default(cuid())
  year        String
  date        String
  title       String
  description String
  type        EventType @default(MILESTONE)

  projectId   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([year])
  @@index([type])
  @@map("timeline_events")
}

enum EventType {
  MILESTONE
  JOB
  LIFE
}

// 当前状态 (Current Status 卡片)
model CurrentStatus {
  id           String   @id @default(cuid())
  title        String   // "BUILDING THE FUTURE"
  currentFocus String   // "Learning Next.js & Rust"
  location     String   // "Neo-City, Sector 7"
  vibe         String   // "💻 Coding / ☕ Coffee"
  emoji        String?  // "💻"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@map("current_status")
}

// 历史项目 (History View 卡片)
model HistoryItem {
  id          String   @id @default(cuid())
  date        String   // "2023年6月"
  title       String   // "个人博客项目"
  role        String   // "全栈开发"
  description String   // 项目描述
  duration    String   @default("") // "9个月2天"
  location    String   @default("") // "远程"
  tags        String[] // ["项目经历", "MongoDB", ...]
  color       String?  // "#a855f7"
  icon        String?  // "FileText", "Briefcase", "Code", "Star"
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([isActive])
  @@map("history_items")
}

// 动漫
model Anime {
  id           String      @id @default(cuid())
  title        String
  cover        String
  bannerImage  String?

  type         AnimeType   @default(TV)
  episodes     Int
  aired        String?
  studios      String[]
  genres       String[]
  synopsis     String?

  currentEp    Int         @default(0)
  status       WatchStatus @default(WATCHING)
  score        Float?
  favorite     Boolean     @default(false)
  notes        String?
  tags         String[]

  startDate    DateTime?
  finishDate   DateTime?

  bilibiliUrl  String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([favorite])
  @@map("anime")
}

enum AnimeType {
  TV
  OVA
  Movie
  Special
  ONA
}

enum WatchStatus {
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
}

// 日记
model Diary {
  id          String     @id @default(cuid())
  type        DiaryType  @default(SHORT)

  content     String?
  stamp       String?

  title       String?
  subtitle    String?
  longContent String?
  location    String?
  mood        String?
  weather     String?
  coverImage  String?

  date        DateTime   @default(now())
  tags        String[]
  readingTime String?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([date])
  @@index([type])
  @@index([type, date])
  @@map("diaries")
}

enum DiaryType {
  SHORT
  LONG
}

// 相册
model GalleryImage {
  id          String   @id @default(cuid())
  title       String
  src         String
  date        DateTime @default(now())
  location    String?
  aspect      Aspect   @default(square)

  description String?

  camera      String?
  settings    String?

  tags        String[]

  albumId     String?
  album       Album?   @relation(fields: [albumId], references: [id])
  comments    PhotoComment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([albumId])
  @@map("gallery_images")
}

enum Aspect {
  portrait
  landscape
  square
}

// 相册集
model Album {
  id          String         @id @default(cuid())
  title       String
  cover       String
  createdAt   DateTime       @default(now())
  lastUpdated DateTime       @updatedAt
  location    String?
  thoughts    String?

  photoCount  Int            @default(0)

  photos      GalleryImage[]

  @@map("albums")
}

// 照片评论
model PhotoComment {
  id        String       @id @default(cuid())
  author    String
  content   String
  date      DateTime     @default(now())

  photoId   String
  photo     GalleryImage @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@map("photo_comments")
}

// 关系网络节点
model NetworkNode {
  id          String     @id @default(cuid())
  name        String
  role        String
  description String
  avatar      String?

  x           Float      @default(0)
  y           Float      @default(0)
  type        NodeType   @default(major)

  connections String[]

  // 按钮配置
  buttonEnabled Boolean   @default(false)
  buttonLabel   String?
  buttonLink    String?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type])
  @@map("network_nodes")
}

// 评论（通用）
model Comment {
  id        String   @id @default(cuid())
  author    String
  content   String
  email     String?

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([createdAt])
  @@map("comments")
}

// 网站统计
model SiteStats {
  id            String   @id @default(cuid())
  date          DateTime @default(now()) @unique

  pageViews     Int      @default(0)
  uniqueVisitors Int     @default(0)

  postViews     Json?

  createdAt     DateTime @default(now())

  @@index([date])
  @@map("site_stats")
}

// 最新活动
model Activity {
  id          String   @id @default(cuid())
  project     String
  title       String
  tags        String[]
  status      ActivityStatus @default(IN_PROGRESS)
  date        DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@map("activities")
}

enum ActivityStatus {
  DONE
  IN_PROGRESS
  PLANNED
}

// 用户
model User {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique
  password    String

  displayName String?
  avatar      String?
  bio         String?
  location    String?
  website     String?
  github      String?

  role        UserRole @default(USER)

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime?

  posts       Post[]   @relation("PostAuthor")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  EDITOR
}

// 站点配置
model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("site_config")
}

// 宇宙图布局（全部模式专用坐标）
model UniverseLayout {
  id        String   @id @default(cuid())
  nodeId    String   @unique  // skill_id 或 person_id
  nodeType  String             // 'skill' 或 'person'
  x         Float    @default(50)
  y         Float    @default(50)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([nodeType])
  @@map("universe_layouts")
}
