generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 文章
model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   // Markdown content
  excerpt     String?
  date        DateTime @default(now())
  category    String
  tags        String[] // PostgreSQL array type
  readingTime String?
  
  // 统计字段
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  
  // 状态
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  
  // 时间戳
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // 关系
  comments    Comment[]
  authorId    String?
  author      User?    @relation("PostAuthor", fields: [authorId], references: [id])
  
  @@index([category])
  @@index([date])
  @@index([isPublished])
  @@index([authorId])
  @@map("posts")
}

// 公告
model Announcement {
  id       String   @id @default(cuid())
  title    String
  content  String
  date     DateTime @default(now())
  type     AnnouncementType @default(INFO)
  
  // 附件（JSON格式存储）
  attachments Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([date])
  @@index([type])
  @@map("announcements")
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  IMPORTANT
}

// 项目
model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  type        String
  tech        String[]      // 技术栈数组
  status      ProjectStatus @default(ACTIVE)
  
  // 链接
  link        String?
  imageUrl    String?
  githubUrl   String?
  demoUrl     String?
  
  // 时间
  startDate   DateTime?
  endDate     DateTime?
  
  // 详细说明
  readme      String?       // Markdown格式
  
  // 标记
  featured    Boolean       @default(false)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([status])
  @@index([featured])
  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DEPLOYED
}

// 技能
model Skill {
  id            String     @id @default(cuid())
  name          String     @unique
  category      String     // FRONTEND.CORE, BACKEND.OPS, DESIGN.ARTS
  level         Int        @default(0) // 0-100
  rank          String     // Master, Expert, Adept, Novice
  projectCount  Int        @default(0)
  
  // 技能图谱节点位置（可选）
  nodeX         Float?
  nodeY         Float?
  nodeType      NodeType?
  connections   String[]   // 关联技能ID数组
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([category])
  @@index([level])
  @@map("skills")
}

enum NodeType {
  core
  major
  minor
}

// 时间线事件
model TimelineEvent {
  id          String    @id @default(cuid())
  year        String
  date        String    // MM.DD格式
  title       String
  description String
  type        EventType @default(MILESTONE)
  
  // 关联项目（可选）
  projectId   String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([year])
  @@index([type])
  @@map("timeline_events")
}

enum EventType {
  MILESTONE
  JOB
  LIFE
}

// 动漫
model Anime {
  id           String      @id @default(cuid())
  title        String
  cover        String      // 颜色值或图片URL
  bannerImage  String?
  
  // 基本信息
  type         AnimeType   @default(TV)
  episodes     Int         // 总集数
  aired        String?     // 播出时间
  studios      String[]    // 制作公司
  genres       String[]    // 类型标签
  synopsis     String?     // 剧情简介
  
  // 个人追踪
  currentEp    Int         @default(0)
  status       WatchStatus @default(WATCHING)
  score        Float?      // 0-10评分
  favorite     Boolean     @default(false)
  notes        String?
  tags         String[]    // 个人标签
  
  // 时间
  startDate    DateTime?
  finishDate   DateTime?
  
  // 外部链接
  bilibiliUrl  String?
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  @@index([status])
  @@index([favorite])
  @@map("anime")
}

enum AnimeType {
  TV
  OVA
  Movie
  Special
  ONA
}

enum WatchStatus {
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
}

// 日记
model Diary {
  id          String     @id @default(cuid())
  type        DiaryType  @default(SHORT)
  
  // 短日记字段
  content     String?    // 短日记内容
  stamp       String?    // 印章文字
  
  // 长文日记字段
  title       String?
  subtitle    String?
  longContent String?    // Markdown长内容
  location    String?
  mood        String?    // 😊 🌙 ☔ 🌸 ⚡
  weather     String?    // ☀️ ☁️ 🌧️ ⛈️ ❄️
  coverImage  String?
  
  // 通用
  date        DateTime   @default(now())
  tags        String[]
  readingTime String?
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@index([date])
  @@index([type])
  @@map("diaries")
}

enum DiaryType {
  SHORT    // 短日记/便签
  LONG     // 长文日记
}

// 相册
model GalleryImage {
  id          String   @id @default(cuid())
  title       String
  src         String   // 图片URL
  date        DateTime @default(now())
  location    String?
  aspect      Aspect   @default(square)
  
  // EXIF信息
  camera      String?
  settings    String?
  
  // 标签
  tags        String[]
  
  // 关系
  albumId     String?
  album       Album?   @relation(fields: [albumId], references: [id])
  comments    PhotoComment[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([date])
  @@index([albumId])
  @@map("gallery_images")
}

enum Aspect {
  portrait
  landscape
  square
}

// 相册集
model Album {
  id          String         @id @default(cuid())
  title       String
  cover       String
  createdAt   DateTime       @default(now())
  lastUpdated DateTime       @updatedAt
  location    String?
  thoughts    String?
  
  // 关系
  photos      GalleryImage[]
  
  @@map("albums")
}

// 照片评论
model PhotoComment {
  id        String       @id @default(cuid())
  author    String
  content   String
  date      DateTime     @default(now())
  
  // 关系
  photoId   String
  photo     GalleryImage @relation(fields: [photoId], references: [id], onDelete: Cascade)
  
  @@index([photoId])
  @@map("photo_comments")
}

// 关系网络节点
model NetworkNode {
  id          String     @id @default(cuid())
  name        String
  role        String     // 关系角色
  description String
  avatar      String?    // 头像URL
  
  // 图谱位置
  x           Float      @default(0)
  y           Float      @default(0)
  type        NodeType   @default(major)
  
  // 关联（存储ID数组）
  connections String[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@index([type])
  @@map("network_nodes")
}

// 评论（通用）
model Comment {
  id        String   @id @default(cuid())
  author    String
  content   String
  email     String?  // 可选，用于通知
  
  // 关系
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  // 嵌套回复
  parentId  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([postId])
  @@index([createdAt])
  @@map("comments")
}

// 网站统计
model SiteStats {
  id            String   @id @default(cuid())
  date          DateTime @default(now()) @unique
  
  // 访问量
  pageViews     Int      @default(0)
  uniqueVisitors Int     @default(0)
  
  // 内容统计
  postViews     Json?    // { postId: count }
  
  createdAt     DateTime @default(now())
  
  @@index([date])
  @@map("site_stats")
}

// 用户
model User {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique
  password    String   // 加密后的密码
  
  // 个人信息
  displayName String?
  avatar      String?
  bio         String?
  location    String?
  website     String?
  github      String?
  
  // 角色
  role        UserRole @default(USER)
  
  // 状态
  isActive    Boolean  @default(true)
  
  // 时间戳
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime?
  
  // 关系
  posts       Post[]   @relation("PostAuthor")
  
  @@index([role])
  @@index([isActive])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  EDITOR
}
