# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ink_spirit_db"

# Server
PORT=3001
NODE_ENV=development

# JWT (for admin auth)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# CORS
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# AI Service Configuration
AI_SERVICE_URL="http://localhost:8000"

# File Upload
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR="uploads"

# Optional: External APIs
# GITHUB_TOKEN="your-github-token"
# ANALYTICS_API_KEY="your-analytics-key"

# Content Directory (for About page files)
CONTENT_DIR="content"

# Database Auto-Initialization
# Set to 'true' to automatically initialize database on first startup
# Set to 'false' to skip auto-initialization (recommended for production)
# Database will only be initialized if it doesn't have any users
INIT_DB="true"  # Enable auto-initialization

# Database Force Reset
# Set to 'true' to force rebuild database (WARNING: deletes all data!)
# Set to 'false' for normal initialization (default)
RESET_DB="false"  # Normal initialization (recommended)

# Behavior:
# - First run: Creates database, tables, and seeds data
# - Subsequent runs: Skips initialization (unless RESET_DB=true)
# - RESET_DB=true: Force rebuilds all tables (deletes data!)
