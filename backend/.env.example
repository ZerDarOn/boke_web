# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ink_spirit_db"

# Server
PORT=3001
NODE_ENV=development

# JWT (for admin auth)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# CORS & Frontend
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# AI Service Configuration (optional)
AI_SERVICE_URL="http://localhost:8000"
# Set the same value in ai-service when maintenance endpoints need protection.
AI_INTERNAL_TOKEN=""

# Security
CSRF_SECRET="your-csrf-secret-change-in-production"
SESSION_SECRET="your-session-secret-change-in-production"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Reverse proxy boundary for client IP rate limiting.
# Default/loopback covers cloudflared or a reverse proxy running on this host.
# For a remote/container proxy, list its exact IP(s) or a narrow CIDR (IPv4 /24+
# or IPv6 /64+). Use 0 to disable. Never use hop counts, private, true, or *.
TRUST_PROXY="loopback"
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=900000

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR="uploads"

# Content Directory (for About page files)
CONTENT_DIR="content"

# Public file explorer storage. The metadata path must stay outside the public
# storage directory. Persist the storage, metadata index, and identity marker
# together. Run only one backend process/replica against this JSON index.
FILE_STORAGE_DIR="content-files"
FILE_METADATA_PATH="storage-metadata/file-metadata.json"
# One-time break-glass migration only after verifying every existing object is public:
# FILE_METADATA_ALLOW_EMPTY_INITIALIZATION=false
# One-time legacy binding only after proving the old index belongs to this storage:
# FILE_METADATA_ALLOW_UNBOUND_MIGRATION=false

# MinIO Object Storage (optional, uses local filesystem if not configured)
# USE_MINIO=false
# MINIO_ENDPOINT="localhost"
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY="minioadmin"
# MINIO_SECRET_KEY="minioadmin123"
# MINIO_BUCKET="ink-spirit-blog"
# MINIO_REQUEST_TIMEOUT_MS=15000

# Optional: External APIs
# GITHUB_TOKEN="your-github-token"
# ANALYTICS_API_KEY="your-analytics-key"

# Steam API (optional, for game library sync)
# STEAM_API_KEY="your-steam-web-api-key"
# STEAM_USER_ID="your-steam-id-64"

# B站追番自动同步 (optional)：配置后每 24h 自动把公开追番导入/补全到 anime 表
# UID = 个人空间地址 space.bilibili.com/<UID> 里的数字；需在 B站打开"公开我的追番/追剧记录"
# 临时关闭公开也没关系——同步失败只记日志，不影响服务器
# BILIBILI_UID="104973922"

# Database Auto-Initialization
INIT_DB="true"
RESET_DB="false"
