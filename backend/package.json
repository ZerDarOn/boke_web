{
  "name": "ink-spirit-backend",
  "version": "1.0.0",
  "description": "INK.SPIRIT Blog Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "npx prisma db seed",
    "db:reset": "prisma db push --force-reset --skip-generate && npm run db:generate && npm run db:seed",
    "db:fix": "tsx scripts/sync-db.ts",
    "db:init": "tsx init-db.ts",
    "db:health": "tsx init-db.ts health",
    "db:force-reset": "tsx init-db.ts reset",
    "db:sync": "tsx init-db.ts schema",
    "db:seed-only": "tsx init-db.ts seed",
    "db:sync-schema": "npm run db:generate && npm run db:push",
    "init": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "test": "jest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts",
    "schema": "prisma/schema.prisma"
  },
  "keywords": [
    "blog",
    "api",
    "nodejs"
  ],
  "author": "CYBER.RONIN",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/pg": "^8.16.0",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "extract-zip": "^2.0.1",
    "gray-matter": "^4.0.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^17.0.4",
    "minio": "^8.0.7",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.18.0",
    "prisma": "^5.22.0",
    "sharp": "^0.32.6",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.33",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2"
  }
}
