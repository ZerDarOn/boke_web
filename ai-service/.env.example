# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ink_spirit_db

# AI Service Configuration
# Choose one or configure multiple

# OpenAI (for GPT models)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_FAST_MODEL=
OPENAI_STANDARD_MODEL=
OPENAI_TEMPERATURE=0.7

# Shared with the Node backend; strongly recommended outside local development.
AI_INTERNAL_TOKEN=

# Optional path to a custom companion persona JSON file.
COMPANION_PERSONA_PATH=

# Anthropic (for Claude models)
ANTHROPIC_API_KEY=sk-ant-your-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# Local LLM (optional)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Cache Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# LLM Configuration
MAX_TOKENS=4000
TIMEOUT_SECONDS=30

# Analytics
ANALYTICS_WINDOW_DAYS=30
TRENDING_MIN_VIEWS=100
