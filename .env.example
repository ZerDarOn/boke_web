# ============================================
# INK.SPIRIT Blog - Docker Compose 环境变量
# ============================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# ============================================
# PostgreSQL 数据库配置
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password-here
POSTGRES_DB=ink_spirit_db
POSTGRES_PORT=5432

# ============================================
# Redis 配置
# ============================================
REDIS_PORT=6379

# ============================================
# MinIO 对象存储配置
# ============================================
USE_MINIO=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-secure-minio-password-here
MINIO_BUCKET=ink-spirit-blog
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_REQUEST_TIMEOUT_MS=15000
# 仅在已人工确认现有文件全部应公开时，临时设为 true 启动一次；成功后立即恢复 false
FILE_METADATA_ALLOW_EMPTY_INITIALIZATION=false
# 仅在已核对旧索引确实属于当前非空存储时，临时设为 true 启动一次
FILE_METADATA_ALLOW_UNBOUND_MIGRATION=false

# ============================================
# 应用服务配置
# ============================================
NODE_ENV=development
FRONTEND_PORT=5173
BACKEND_PORT=3001
AI_SERVICE_PORT=8000

# ============================================
# 前端配置
# ============================================
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ============================================
# 安全配置 (必须修改!)
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
CSRF_SECRET=your-csrf-secret-change-in-production
SESSION_SECRET=your-session-secret-change-in-production

# ============================================
# AI 服务配置 (可选)
# ============================================
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# LOCAL_LLM_URL=http://localhost:11434/v1
# COMPANION_PERSONA_PATH=/app/config/companion_persona.json
